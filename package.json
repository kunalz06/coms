{
  "name": "comms",
  "version": "0.1.0",
  "private": true,
  "description": "COMMS is a minimal messaging and audio/video calling app.",
  "scripts": {
    "dev": "cd clients/comms_flutter && flutter run -d chrome --dart-define-from-file=env/local.json",
    "build": "cd clients/comms_flutter && flutter build web --release --dart-define-from-file=env/local.json",
    "backend:dev": "tsx watch server/index.ts",
    "backend:build": "tsc -p tsconfig.server.json",
    "backend:start": "node dist-server/server/index.js",
    "legacy:web:build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@supabase/supabase-js": "latest",
    "firebase": "latest",
    "firebase-admin": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "web-push": "^3.6.7",
    "ws": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "@types/ws": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
